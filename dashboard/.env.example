# Set by HappyRobot Apps when the Twin gateway is deployed (Settings -> Twin Database -> Deploy Gateway).
# Without them the app shows sample data, so it can be previewed anywhere.
NEXT_PUBLIC_TWIN_GATEWAY=
NEXT_PUBLIC_ORG_ID=
# Twin table written by the call workflow's "Write to Twin" node.
TWIN_TABLE=carrier_calls
# Basic-auth password for the ops manager (user: ops). Leave empty only for local previews.
DASHBOARD_PASSWORD=
