# Twin access (server side only). Preferred: HappyRobot public API v2 with an organization key
# (Settings -> API Keys; role with Twin read + data edit). Without any Twin variables the app shows sample data.
HAPPYROBOT_API_KEY=
# HAPPYROBOT_API_BASE=https://platform.happyrobot.ai/api/v2
# Alternative: the Twin gateway (inside HappyRobot Apps these come as NEXT_PUBLIC_TWIN_GATEWAY / NEXT_PUBLIC_ORG_ID)
TWIN_GATEWAY_URL=
TWIN_ORG_ID=
# Twin table written by the call workflow's "Write to Twin" node.
TWIN_TABLE=carrier_calls
# Basic-auth password for the ops manager (user: ops). Leave empty only for local previews.
DASHBOARD_PASSWORD=
