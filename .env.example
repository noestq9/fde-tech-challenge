# Copy to .env and fill in. Never commit .env.

# Shared secret the HappyRobot workflow sends as X-API-Key (generate with: openssl rand -hex 32)
API_KEY=

# FMCSA: mock | live (live needs a free webKey from https://mobile.fmcsa.dot.gov/QCDevsite/)
FMCSA_MODE=mock
FMCSA_WEB_KEY=

# Legacy TMS. With docker compose, leave TMS_HOST/PORT/TOKEN empty to use the bundled fake TMS.
# Fill them with the values from the candidate portal to use the real one. Never commit the token.
TMS_MODE=live
TMS_HOST=
TMS_PORT=
TMS_TOKEN=
TMS_CONNECT_TIMEOUT_MS=2000
TMS_TIMEOUT_MS=3000
TMS_RETRIES=3
TMS_BUDGET_MS=8000
TMS_MAX_RESULTS=10
# Optional JSONL journal of every booking attempt
TMS_BOOKING_JOURNAL=

# OTP delivery: console (dev only, logs the code) | webhook (HappyRobot workflow that sends SMS/email)
# | simulated (sends nothing; the code is always OTP_SIMULATED_CODE; needs ALLOW_OTP_DEMO=true in production)
OTP_DELIVERY=console
OTP_SIMULATED_CODE=1218
# URL of the HappyRobot workflow's Webhook (API) trigger, and a HappyRobot API key (sent as Bearer)
OTP_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
# Demo only: every OTP goes here (your phone in E.164, e.g. +5215512345678, or your email)
OTP_DEMO_CONTACT=
# The Docker image runs with NODE_ENV=production; set this to true to allow OTP_DEMO_CONTACT there (demo deployments only)
ALLOW_OTP_DEMO=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_SENDS=2

# Share of the (max_rate - loadboard_rate) gap offered on counter rounds 1, 2 and 3
NEGOTIATION_STEPS=0.35,0.70,1.0
RATE_ROUNDING=5
# Opening offer = min(listed rate, ceiling x OPENING_RATIO)
OPENING_RATIO=0.9
# Ceiling when the token does not expose MAX_BUY (share of the listed rate)
FALLBACK_CEILING_RATIO=1.0
LOADS_TO_PITCH=3

PORT=8080
LOG_LEVEL=info
