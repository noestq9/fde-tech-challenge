{
  "name": "inbound-carrier-sales",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the HappyRobot inbound carrier sales agent: FMCSA check, OTP, load search, negotiation and booking.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --dir test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tms:fake": "tsx src/fakeTms/main.ts",
    "tms:probe": "tsx src/scripts/tmsProbe.ts",
    "tms:dump": "tsx src/scripts/tmsDump.ts",
    "tms:inventory": "tsx src/scripts/tmsInventory.ts",
    "fmcsa:check": "tsx src/scripts/fmcsaCheck.ts",
    "sim:calls": "tsx src/scripts/simulateCalls.ts",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
